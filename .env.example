# Chave da API do Google (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# Postgres do docker-compose
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=documento_pdf

# Caminho do PDF (relativo à raiz do projeto ou absoluto)
PDF_PATH=document.pdf
